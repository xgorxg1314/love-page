---
import type { Config } from '../config';
import { withBaseUrl } from '../config/base';
import type { LocaleMessages } from '../i18n/utils';
import { DEFAULT_MESSAGES } from '../i18n/utils';

interface Props {
  config: Config;
  messages?: LocaleMessages;
}

const { config, messages } = Astro.props;
const showPhotoWall = !!config.photos?.length;
// 站内相对路径自动补 base（/love-page/），完整网址原样保留
const photos = (config.photos ?? []).map((p) => ({ ...p, url: withBaseUrl(p.url) }));
const defaultPhotoWallLabels = DEFAULT_MESSAGES.photoWall;
const ui = {
  title: messages?.photoWall?.title || defaultPhotoWallLabels.title,
  close: messages?.photoWall?.close || defaultPhotoWallLabels.close,
  prev: messages?.photoWall?.prev || defaultPhotoWallLabels.prev,
  next: messages?.photoWall?.next || defaultPhotoWallLabels.next,
  preview: messages?.photoWall?.preview || defaultPhotoWallLabels.preview,
};
---

{showPhotoWall && (
  <>
    <div id="photoWallOverlay" class="photo-wall-overlay" aria-hidden="true">
      <div class="photo-wall-panel glass">
        <button class="photo-wall-close" aria-label={ui.close}>
          ×
        </button>
        <h3 class="photo-wall-title">📷 {ui.title}</h3>
        <div class="photo-wall-grid" id="photoWallGrid">
          {photos.map((p, i) => (
            <div class="photo-wall-item reveal" style={`--i: ${i}`} data-url={p.url} data-caption={p.caption ?? ''} data-index={i} role="button" tabindex="0">
              <img src={p.url} alt={p.caption ?? ''} loading="lazy" />
              {p.caption && <span class="photo-wall-caption">{p.caption}</span>}
            </div>
          ))}
        </div>
      </div>
    </div>
  </>
)}

{showPhotoWall && (
  <script define:vars={{ photos, uiLabels: ui }}>
      document.addEventListener('DOMContentLoaded', () => {
        const entry = document.getElementById('photoWallEntry');
        const overlay = document.getElementById('photoWallOverlay');
        const closeBtn = overlay?.querySelector('.photo-wall-close');
        const grid = document.getElementById('photoWallGrid');
        if (!entry || !overlay || !grid) return;

        entry.style.display = 'flex';

        entry.addEventListener('click', () => {
          overlay.classList.add('show');
          overlay.setAttribute('aria-hidden', 'false');
        });

        const close = () => {
          overlay.classList.remove('show');
          overlay.setAttribute('aria-hidden', 'true');
        };

        closeBtn?.addEventListener('click', close);
        overlay.addEventListener('click', (e) => {
          if (e.target === overlay) close();
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && overlay.classList.contains('show')) close();
        });

        // Lightbox
        function openLightbox(index) {
          const items = photos || [];
          if (!items.length) return;
          let idx = ((index % items.length) + items.length) % items.length;

          const ui = uiLabels;
          const lb = document.createElement('div');
          lb.className = 'photo-lightbox';
          lb.setAttribute('role', 'dialog');
          lb.setAttribute('aria-label', ui.preview);
          lb.innerHTML =
            `<button class="photo-lightbox-close" aria-label="${ui.close}">×</button>` +
            `<button class="photo-lightbox-prev" aria-label="${ui.prev}">‹</button>` +
            `<div class="photo-lightbox-content">` +
            `<img src="" alt="" />` +
            `<span class="photo-lightbox-caption"></span>` +
            `</div>` +
            `<button class="photo-lightbox-next" aria-label="${ui.next}">›</button>`;

          const img = lb.querySelector('img');
          const cap = lb.querySelector('.photo-lightbox-caption');

          function show() {
            const p = items[idx];
            img.src = p.url;
            img.alt = p.caption || '';
            cap.textContent = p.caption || '';
            cap.style.display = p.caption ? '' : 'none';
          }

          function closeLb() {
            lb.classList.remove('show');
            document.removeEventListener('keydown', keyHandler);
            setTimeout(() => lb.remove(), 300);
          }

          function keyHandler(e) {
            if (e.key === 'Escape') closeLb();
            else if (e.key === 'ArrowLeft') { idx = (idx - 1 + items.length) % items.length; show(); }
            else if (e.key === 'ArrowRight') { idx = (idx + 1) % items.length; show(); }
          }

          lb.querySelector('.photo-lightbox-close').onclick = closeLb;
          lb.querySelector('.photo-lightbox-prev').onclick = () => {
            idx = (idx - 1 + items.length) % items.length;
            show();
          };
          lb.querySelector('.photo-lightbox-next').onclick = () => {
            idx = (idx + 1) % items.length;
            show();
          };
          lb.onclick = (e) => { if (e.target === lb) closeLb(); };

          document.addEventListener('keydown', keyHandler);
          document.body.appendChild(lb);
          show();
          requestAnimationFrame(() => lb.classList.add('show'));

          let touchStartX = 0;
          lb.addEventListener('touchstart', (e) => { touchStartX = e.touches[0].clientX; }, { passive: true });
          lb.addEventListener('touchend', (e) => {
            const dx = e.changedTouches[0].clientX - touchStartX;
            if (Math.abs(dx) > 50) {
              if (dx > 0) idx = (idx - 1 + items.length) % items.length;
              else idx = (idx + 1) % items.length;
              show();
            }
          }, { passive: true });
        }

        grid.addEventListener('click', (e) => {
          const item = e.target.closest('.photo-wall-item');
          if (!item) return;
          const i = parseInt(item.dataset.index || '0', 10);
          openLightbox(i);
        });
      });
  </script>
)}
